# Global development mode flag.
# Enables local disk caching (cache/) and CSV export in the CLI.
# Defaults to ON locally, OFF on Vercel (serverless filesystems are read-only
# except /tmp). Set explicitly to override, e.g. DEVELOPMENT_MODE=false.
DEVELOPMENT_MODE=true

# Default model to use (must exist in providers.json).
# Ollama examples: "gemma4:latest", "qwen3:4b", "mistral:7b"
# Gemini examples: "gemini-2.5-pro", "gemini-2.5-flash"
DEFAULT_MODEL=gemma4:latest

# API keys — only needed for providers whose api_key_env is set in providers.json.
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel Blob — required for persistent resume storage on Vercel.
# Create a blob store in Vercel → Storage and copy the read/write token into
# this variable (both locally and as a Vercel environment variable).
# When set, uploaded resumes are stored in a private Vercel Blob store.
# When unset, files are written locally to the uploads/ directory (local dev only).
BLOB_READ_WRITE_TOKEN=your_blob_read_write_token

# Comma-separated list of allowed frontend origins (CORS).
# Defaults to local Vite dev + the deployed SkillSignal frontend.
# CORS_ORIGINS=http://localhost:5173,https://skill-signal-frontend-tau.vercel.app
